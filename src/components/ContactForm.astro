<form id="contactForm" class="space-y-6 bg-white p-6 sm:p-10 rounded-3xl shadow-2xl border border-gray-100/50">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="space-y-2">
      <label for="nombre" class="text-sm font-bold text-dark/70 ml-1">Nombre completo *</label>
      <input 
        type="text" 
        name="nombre" 
        id="nombre" 
        required 
        class="w-full px-5 py-4 rounded-2xl border border-gray-100 bg-gray-50/50 focus:bg-white focus:ring-4 focus:ring-primary/5 focus:border-primary outline-none transition-all duration-300 placeholder:text-gray-300"
        placeholder="Tu nombre completo..."
      />
      <p id="error-nombre" class="text-xs text-primary font-medium mt-1.5 hidden opacity-0 transition-all duration-300"></p>
    </div>
    <div class="space-y-2">
      <label for="email" class="text-sm font-bold text-dark/70 ml-1">Correo electrónico *</label>
      <input 
        type="email" 
        name="email" 
        id="email" 
        required 
        class="w-full px-5 py-4 rounded-2xl border border-gray-100 bg-gray-50/50 focus:bg-white focus:ring-4 focus:ring-primary/5 focus:border-primary outline-none transition-all duration-300 placeholder:text-gray-300"
        placeholder="ejemplo@correo.com"
      />
      <p id="error-email" class="text-xs text-primary font-medium mt-1.5 hidden opacity-0 transition-all duration-300"></p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="space-y-2">
      <label for="phone" class="text-sm font-bold text-dark/70 ml-1">Teléfono (WhatsApp)</label>
      <input 
        type="tel" 
        name="phone" 
        id="phone" 
        class="w-full px-5 py-4 rounded-2xl border border-gray-100 bg-gray-50/50 focus:bg-white focus:ring-4 focus:ring-primary/5 focus:border-primary outline-none transition-all duration-300 placeholder:text-gray-300"
        placeholder="+34 000 000 000"
      />
      <p id="error-phone" class="text-xs text-primary font-medium mt-1.5 hidden opacity-0 transition-all duration-300"></p>
    </div>
    <div class="space-y-2">
      <label for="codigopostal" class="text-sm font-bold text-dark/70 ml-1">Código Postal</label>
      <input 
        type="text" 
        name="codigopostal" 
        id="codigopostal" 
        pattern="[0-9]{5}"
        title="Cinco dígitos numéricos"
        class="w-full px-5 py-4 rounded-2xl border border-gray-100 bg-gray-50/50 focus:bg-white focus:ring-4 focus:ring-primary/5 focus:border-primary outline-none transition-all duration-300 placeholder:text-gray-300"
        placeholder="28001"
      />
      <p id="error-codigopostal" class="text-xs text-primary font-medium mt-1.5 hidden opacity-0 transition-all duration-300"></p>
    </div>
  </div>

  <div class="space-y-2">
    <label for="Asunto" class="text-sm font-bold text-dark/70 ml-1">Asunto *</label>
    <input 
      type="text" 
      name="Asunto" 
      id="Asunto" 
      required 
      class="w-full px-5 py-4 rounded-2xl border border-gray-100 bg-gray-50/50 focus:bg-white focus:ring-4 focus:ring-primary/5 focus:border-primary outline-none transition-all duration-300 placeholder:text-gray-300"
      placeholder="¿Cómo podemos ayudarte?"
    />
    <p id="error-Asunto" class="text-xs text-primary font-medium mt-1.5 hidden opacity-0 transition-all duration-300"></p>
  </div>

  <div class="space-y-2">
    <label for="Mensaje" class="text-sm font-bold text-dark/70 ml-1">Mensaje *</label>
    <textarea 
      name="Mensaje" 
      id="Mensaje" 
      rows="4" 
      required 
      class="w-full px-5 py-4 rounded-2xl border border-gray-100 bg-gray-50/50 focus:bg-white focus:ring-4 focus:ring-primary/5 focus:border-primary outline-none transition-all duration-300 placeholder:text-gray-300 resize-y min-h-[128px]"
      placeholder="Escribe tu mensaje aquí..."
    ></textarea>
    <p id="error-Mensaje" class="text-xs text-primary font-medium mt-1.5 hidden opacity-0 transition-all duration-300"></p>
  </div>

  <div class="space-y-1 py-2">
    <div class="flex items-start gap-3">
      <input 
        type="checkbox" 
        name="privacy" 
        id="privacy" 
        required 
        class="mt-1 w-5 h-5 rounded border-gray-200 text-primary focus:ring-primary transition-all cursor-pointer accent-primary"
      />
      <label for="privacy" class="text-sm text-gray-500 leading-relaxed cursor-pointer select-none">
        Al hacer click aceptas nuestros <span class="text-dark font-bold">Términos y Condiciones</span> y <span class="text-dark font-bold">Políticas de Privacidad</span>.
        <button type="button" id="openPrivacy" class="text-primary font-bold hover:underline ml-1 cursor-pointer">(Leer más)</button>
      </label>
    </div>
    <p id="error-privacy" class="text-xs text-primary font-medium mt-1 hidden opacity-0 transition-all duration-300"></p>
  </div>
  
  {/* Campo trampa para bots (Honeypot) - Invisible para humanos */}
  <input type="text" name="_honeypot" style="display:none" tabindex="-1" autocomplete="off" />

  <button 
    type="submit" 
    id="formSubmit"
    class="w-full bg-primary cursor-pointer text-white font-black py-5 rounded-2xl transition-all shadow-2xl hover:shadow-primary/30 flex items-center justify-center gap-3 group relative overflow-hidden active:scale-110"
  >
    <span class="z-10 relative flex items-center gap-3">
      Enviar mensaje
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
    </span>
  </button>
  
  <div id="formStatus" aria-live="polite" class="hidden text-center p-5 rounded-2xl font-bold border-2 transition-all duration-500 scale-95 opacity-0"></div>
</form>

<!-- Modal de Privacidad -->
<div id="privacyModal" class="fixed inset-0 z-60 items-center justify-center bg-dark/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 hidden">
  <div id="privacy-modal-content" class="relative w-[calc(100%-2rem)] max-w-2xl bg-white rounded-3xl shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300">
    <!-- Header -->
    <div class="px-8 py-6 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
      <div class="w-10"></div> <!-- Spacer -->
      <h3 class="text-xl font-black text-dark flex items-center justify-center gap-2 flex-1 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Privacidad y Términos
      </h3>
      <button type="button" id="closePrivacyIcon" class="p-2 hover:bg-gray-100 rounded-full transition-colors text-gray-400">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
    
    <!-- Content -->
    <div class="p-8 max-h-[60vh] overflow-y-auto space-y-6 text-gray-600 leading-relaxed text-center">
      <div class="space-y-4">
        <p><strong>Responsable:</strong> Asociación de Solidaridad e Integración Sociolaboral de Venezuela (ASISVE).</p>
        <p><strong>Finalidad:</strong> Gestionar tu solicitud de contacto, responder a tus consultas y, si lo autorizas, enviarte información sobre nuestras actividades sociales.</p>
        <p><strong>Legitimación:</strong> Tu consentimiento expreso al marcar la casilla de aceptación.</p>
        <p><strong>Destinatarios:</strong> Tus datos no se cederán a terceros, salvo obligación legal. Se tratan con absoluta confidencialidad.</p>
        <p><strong>Derechos:</strong> Puedes acceder, rectificar y suprimir tus datos enviando un email a <span class="text-primary font-bold">contacto@asisve.org</span>.</p>
      </div>
      <div class="bg-primary/5 p-4 rounded-xl border border-primary/10 mx-auto max-w-md">
        <p class="text-xs font-medium text-dark/70 italic">
          Al cerrar este modal, volverás al formulario. Tus datos no se enviarán hasta que pulses el botón "Enviar mensaje".
        </p>
      </div>
    </div>
    
    <!-- Footer -->
    <div class="p-6 bg-gray-50 border-t border-gray-100 flex justify-center">
      <button type="button" id="closePrivacyBtn" class="bg-primary hover:bg-dark text-white px-10 py-3 rounded-xl font-bold transition-all shadow-lg hover:shadow-primary/20 hover:-translate-y-0.5 active:translate-y-0 min-w-[150px]">
        Entendido
      </button>
    </div>
  </div>
</div>

<script>
  import { ApiClient } from '../services/api.client';

  const form = document.querySelector('#contactForm') as HTMLFormElement;
  const statusEl = document.querySelector('#formStatus') as HTMLDivElement;
  const submitBtn = document.querySelector('#formSubmit') as HTMLButtonElement;

  // Form inputs
  const nombreInput = document.querySelector('#nombre') as HTMLInputElement;
  const emailInput = document.querySelector('#email') as HTMLInputElement;
  const phoneInput = document.querySelector('#phone') as HTMLInputElement;
  const codigopostalInput = document.querySelector('#codigopostal') as HTMLInputElement;
  const asuntoInput = document.querySelector('#Asunto') as HTMLInputElement;
  const mensajeInput = document.querySelector('#Mensaje') as HTMLTextAreaElement;
  const privacyInput = document.querySelector('#privacy') as HTMLInputElement;

  // Error containers
  const errorNombre = document.querySelector('#error-nombre') as HTMLParagraphElement;
  const errorEmail = document.querySelector('#error-email') as HTMLParagraphElement;
  const errorPhone = document.querySelector('#error-phone') as HTMLParagraphElement;
  const errorCodigopostal = document.querySelector('#error-codigopostal') as HTMLParagraphElement;
  const errorAsunto = document.querySelector('#error-Asunto') as HTMLParagraphElement;
  const errorMensaje = document.querySelector('#error-Mensaje') as HTMLParagraphElement;
  const errorPrivacy = document.querySelector('#error-privacy') as HTMLParagraphElement;

  // Track fields touched by user to avoid premature validation feedback (UX enhancement)
  const touchedFields = new Set<string>();

  // Modal Logic
  const openModalBtn = document.querySelector('#openPrivacy') as HTMLButtonElement;
  const closeModalBtn = document.querySelector('#closePrivacyBtn') as HTMLButtonElement;
  const closeModalBtnIcon = document.querySelector('#closePrivacyIcon') as HTMLButtonElement;
  const modal = document.querySelector('#privacyModal') as HTMLDivElement;
  const modalContent = document.querySelector('#privacy-modal-content');

  const toggleModal = (show: boolean) => {
    if (show && modal && modalContent) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.classList.add('opacity-100');
        modalContent.classList.remove('scale-95');
        modalContent.classList.add('scale-100');
      });
    } else if (modal && modalContent) {
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0', 'pointer-events-none');
      modalContent.classList.remove('scale-100');
      modalContent.classList.add('scale-95');
      document.body.style.overflow = '';
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }, 300);
    }
  };

  openModalBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    toggleModal(true);
  });

  [closeModalBtn, closeModalBtnIcon].forEach(btn => {
    btn?.addEventListener('click', () => toggleModal(false));
  });

  // Validation Styles
  const NORMAL_CLASSES = ['border-gray-100', 'bg-gray-50/50', 'focus:ring-primary/5'];
  const ERROR_CLASSES = ['border-primary-light', 'bg-primary-contrast/30', 'focus:ring-primary/10'];

  function showError(input: HTMLInputElement | HTMLTextAreaElement, errorEl: HTMLParagraphElement, message: string) {
    if (input.type !== 'checkbox') {
      NORMAL_CLASSES.forEach(c => input.classList.remove(c));
      ERROR_CLASSES.forEach(c => input.classList.add(c));
    }
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
    requestAnimationFrame(() => {
      errorEl.classList.remove('opacity-0');
      errorEl.classList.add('opacity-100');
    });
    input.setAttribute('aria-invalid', 'true');
  }

  function clearError(input: HTMLInputElement | HTMLTextAreaElement, errorEl: HTMLParagraphElement) {
    if (input.type !== 'checkbox') {
      ERROR_CLASSES.forEach(c => input.classList.remove(c));
      NORMAL_CLASSES.forEach(c => input.classList.add(c));
    }
    errorEl.classList.remove('opacity-100');
    errorEl.classList.add('opacity-0');
    input.setAttribute('aria-invalid', 'false');
    setTimeout(() => {
      if (errorEl.classList.contains('opacity-0')) {
        errorEl.classList.add('hidden');
      }
    }, 300);
  }

  // Validators
  function validateNombre(isInputEvent = false): boolean {
    if (isInputEvent && !touchedFields.has('nombre')) return true;

    const value = nombreInput.value.trim();
    if (!value) {
      showError(nombreInput, errorNombre, 'El nombre completo es obligatorio.');
      return false;
    }
    if (value.length < 3) {
      showError(nombreInput, errorNombre, 'El nombre debe tener al menos 3 caracteres.');
      return false;
    }
    if (!/^[a-zA-ZáéíóúÁÉÍÓÚñÑüÜïÏ\s'-]+$/.test(value)) {
      showError(nombreInput, errorNombre, 'El nombre solo puede contener letras y espacios.');
      return false;
    }
    clearError(nombreInput, errorNombre);
    return true;
  }

  function validateEmail(isInputEvent = false): boolean {
    if (isInputEvent && !touchedFields.has('email')) return true;

    const value = emailInput.value.trim();
    if (!value) {
      showError(emailInput, errorEmail, 'El correo electrónico es obligatorio.');
      return false;
    }
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(value)) {
      showError(emailInput, errorEmail, 'Ingresa un correo electrónico válido (ejemplo@correo.com).');
      return false;
    }
    clearError(emailInput, errorEmail);
    return true;
  }

  function validatePhone(isInputEvent = false): boolean {
    if (isInputEvent && !touchedFields.has('phone')) return true;

    const value = phoneInput.value.trim();
    if (!value) {
      clearError(phoneInput, errorPhone);
      return true;
    }
    const phoneRegex = /^\+?[0-9\s-]{9,20}$/;
    const digitsOnly = value.replace(/[^0-9]/g, '');
    if (!phoneRegex.test(value) || digitsOnly.length < 9) {
      showError(phoneInput, errorPhone, 'Ingresa un número de teléfono válido (mínimo 9 dígitos).');
      return false;
    }
    clearError(phoneInput, errorPhone);
    return true;
  }

  function validateCodigopostal(isInputEvent = false): boolean {
    if (isInputEvent && !touchedFields.has('codigopostal')) return true;

    const value = codigopostalInput.value.trim();
    if (!value) {
      clearError(codigopostalInput, errorCodigopostal);
      return true;
    }
    if (value.length !== 5 || !/^[0-9]{5}$/.test(value)) {
      showError(codigopostalInput, errorCodigopostal, 'El código postal debe tener exactamente 5 números.');
      return false;
    }
    clearError(codigopostalInput, errorCodigopostal);
    return true;
  }

  function validateAsunto(isInputEvent = false): boolean {
    if (isInputEvent && !touchedFields.has('Asunto')) return true;

    const value = asuntoInput.value.trim();
    if (!value) {
      showError(asuntoInput, errorAsunto, 'El asunto es obligatorio.');
      return false;
    }
    if (value.length < 5) {
      showError(asuntoInput, errorAsunto, 'El asunto debe tener al menos 5 caracteres.');
      return false;
    }
    clearError(asuntoInput, errorAsunto);
    return true;
  }

  function validateMensaje(isInputEvent = false): boolean {
    if (isInputEvent && !touchedFields.has('Mensaje')) return true;

    const value = mensajeInput.value.trim();
    if (!value) {
      showError(mensajeInput, errorMensaje, 'El mensaje es obligatorio.');
      return false;
    }
    if (value.length < 10) {
      showError(mensajeInput, errorMensaje, 'El mensaje debe tener al menos 10 caracteres.');
      return false;
    }
    clearError(mensajeInput, errorMensaje);
    return true;
  }

  function validatePrivacy(): boolean {
    if (!privacyInput.checked) {
      showError(privacyInput, errorPrivacy, 'Debes aceptar los Términos y Condiciones y Políticas de Privacidad.');
      return false;
    }
    clearError(privacyInput, errorPrivacy);
    return true;
  }

  // Live filtering and listeners
  nombreInput?.addEventListener('input', () => validateNombre(true));
  nombreInput?.addEventListener('blur', () => {
    touchedFields.add('nombre');
    validateNombre(false);
  });
  
  emailInput?.addEventListener('input', () => validateEmail(true));
  emailInput?.addEventListener('blur', () => {
    touchedFields.add('email');
    validateEmail(false);
  });
  
  phoneInput?.addEventListener('input', () => {
    let val = phoneInput.value;
    const hasPlus = val.startsWith('+');
    val = val.replace(/[^0-9\s-]/g, '');
    if (hasPlus) {
      val = '+' + val;
    }
    phoneInput.value = val;
    validatePhone(true);
  });
  phoneInput?.addEventListener('blur', () => {
    touchedFields.add('phone');
    validatePhone(false);
  });
  
  codigopostalInput?.addEventListener('input', () => {
    codigopostalInput.value = codigopostalInput.value.replace(/[^0-9]/g, '').slice(0, 5);
    validateCodigopostal(true);
  });
  codigopostalInput?.addEventListener('blur', () => {
    touchedFields.add('codigopostal');
    validateCodigopostal(false);
  });
  
  asuntoInput?.addEventListener('input', () => validateAsunto(true));
  asuntoInput?.addEventListener('blur', () => {
    touchedFields.add('Asunto');
    validateAsunto(false);
  });
  
  mensajeInput?.addEventListener('input', () => validateMensaje(true));
  mensajeInput?.addEventListener('blur', () => {
    touchedFields.add('Mensaje');
    validateMensaje(false);
  });
  
  privacyInput?.addEventListener('change', () => {
    touchedFields.add('privacy');
    validatePrivacy();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Mark all fields as touched to display errors immediately on submit attempt
    ['nombre', 'email', 'phone', 'codigopostal', 'Asunto', 'Mensaje', 'privacy'].forEach(f => touchedFields.add(f));

    // Run all validations
    const isNombreValid = validateNombre(false);
    const isEmailValid = validateEmail(false);
    const isPhoneValid = validatePhone(false);
    const isCpValid = validateCodigopostal(false);
    const isAsuntoValid = validateAsunto(false);
    const isMensajeValid = validateMensaje(false);
    const isPrivacyValid = validatePrivacy();

    const isFormValid = isNombreValid && isEmailValid && isPhoneValid && isCpValid && isAsuntoValid && isMensajeValid && isPrivacyValid;

    if (!isFormValid) {
      const firstInvalidInput = form.querySelector('[aria-invalid="true"]') as HTMLElement;
      if (firstInvalidInput) {
        firstInvalidInput.focus();
        firstInvalidInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      return;
    }

    const formData = new FormData(form);
    const dataObj = Object.fromEntries(formData);
    
    // Estado de carga
    submitBtn.disabled = true;
    submitBtn.classList.add('opacity-50', 'pointer-events-none');
    
    statusEl.textContent = 'Procesando tu mensaje...';
    statusEl.className = 'text-center p-5 rounded-2xl font-bold border-2 bg-blue-50/50 border-blue-200 text-blue-600 animate-pulse block scale-100 opacity-100';
    statusEl.classList.remove('hidden');

    // Realizar la petición a nuestra nueva API en PHP
    const result = await ApiClient.post('/contact.php', dataObj);

    // Scroll al mensaje de estado
    statusEl.scrollIntoView({ behavior: 'smooth', block: 'center' });

    // Reset de botón
    submitBtn.disabled = false;
    submitBtn.classList.remove('opacity-50', 'pointer-events-none');

    if (result.success) {
      statusEl.textContent = result.message || '¡Mensaje enviado con éxito!';
      statusEl.className = 'text-center p-5 rounded-2xl font-bold border-2 bg-green-50/50 border-green-200 text-green-700 block scale-100 opacity-100';
      form.reset();
      touchedFields.clear(); // Reset touched status
      
      // Ocultar mensaje después de 5 segundos
      setTimeout(() => {
        statusEl.classList.add('opacity-0', 'scale-95');
        setTimeout(() => statusEl.classList.add('hidden'), 500);
      }, 5000);
    } else {
      statusEl.textContent = result.message || 'Error: No se pudo enviar el mensaje.';
      statusEl.className = 'text-center p-5 rounded-2xl font-bold border-2 bg-red-50/50 border-red-200 text-red-700 block scale-100 opacity-100';
    }
  });
</script>
